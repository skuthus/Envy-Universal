# Maintainer: Skyler Schoos
#
# envynote: Envy for Omarchy from the prebuilt release tarball that
# scripts/release.sh publishes. The tarball is exactly the tree package()
# copies below, so a release and this file move in lockstep: bump
# _tauriver, paste the sha256 the release script prints, `updpkgsums` if you
# would rather, and publish (scripts/publish-repo.sh, or the AUR if it opens).
#
# Test locally against a dry-run tarball without uploading anything:
#   scripts/release.sh --dry-run
#   cd linux && makepkg -f --skipchecksums
# (the source() below resolves to a local file when ENVY_LOCAL_TARBALL points
# at one, which the release script sets for its own check).

pkgname=envynote
_tauriver=1.0.2
# pacman forbids "-" in a version; the tag and tarball keep Tauri's spelling.
pkgver=${_tauriver//-/}
pkgrel=1
pkgdesc="Flat-file, frictionless note-taking that follows the Omarchy theme"
arch=('x86_64')
url="https://github.com/skuthus/Envy-Linux"
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3')
# Envy runs on any Wayland or X11 desktop; Hyprland unlocks the summon bind,
# tiling settings and Keep on Top, and Omarchy the bar widget and theme.
optdepends=('hyprland: Ctrl+Alt+Return summon bind, tiled/floating settings, Keep on Top'
            'omarchy: bar widget and theme following')
options=('!strip')
_tarball="envynote-${_tauriver}-x86_64.tar.gz"
if [ -n "${ENVY_LOCAL_TARBALL:-}" ]; then
  source=("${_tarball}::file://${ENVY_LOCAL_TARBALL}")
else
  source=("${url}/releases/download/v${_tauriver}/${_tarball}")
fi
sha256sums=('SKIP')

package() {
  cd "$srcdir/envynote-${_tauriver}"
  install -Dm755 envynote "$pkgdir/usr/bin/envynote"
  install -Dm644 envy.desktop "$pkgdir/usr/share/applications/envy.desktop"
  install -Dm644 icons/32.png "$pkgdir/usr/share/icons/hicolor/32x32/apps/envy.png"
  install -Dm644 icons/128.png "$pkgdir/usr/share/icons/hicolor/128x128/apps/envy.png"
  install -Dm644 icons/256.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/envy.png"
  install -Dm644 icons/512.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/envy.png"
  # The Hyprland bind file and the summon script it runs, side by side, so
  # `pcall(dofile, "/usr/share/envy/hyprland-envy.lua")` is the whole install.
  install -Dm644 hyprland-envy.lua "$pkgdir/usr/share/envy/hyprland-envy.lua"
  install -Dm755 envy-summon.sh "$pkgdir/usr/share/envy/envy-summon.sh"
  # The agent skill. Envy links it into ~/.claude/skills/envy and
  # ~/.agents/skills/envy on launch, so agents can read and edit
  # ~/.config/envy/config.md without being told how each time.
  while IFS= read -r -d '' _skillfile; do
    install -Dm644 "$_skillfile" \
      "$pkgdir/usr/share/envy/agents/skills/envy/${_skillfile#agents/skills/envy/}"
  done < <(find agents/skills/envy -type f -print0)
  install -Dm644 README.md "$pkgdir/usr/share/doc/envy/README.md"
  # The guide every new Index starts with, readable without opening Envy.
  install -Dm644 "Welcome to Envy.md" "$pkgdir/usr/share/doc/envy/Welcome to Envy.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
